{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build AlgoQuest",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-g", "-std=c11", "-Wall", "-Wextra",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/structures/stack.c",
                "${workspaceFolder}/structures/queue.c",
                "${workspaceFolder}/structures/circular_queue.c",
                "${workspaceFolder}/graphics/stack_visualizer.c",
                "${workspaceFolder}/graphics/queue_visualizer.c",
                "-o", "${workspaceFolder}/AlgoQuest.exe",
                "-IC:/msys64/ucrt64/include",
                "-LC:/msys64/ucrt64/lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        }
    ]
}
